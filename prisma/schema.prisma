generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Certificate {
  id          String   @id @default(cuid())
  code        String   @unique
  schoolName  String
  studentName String
  rollNo      String
  className   String
  photoUrl    String?
  createdAt   DateTime @default(now())
}

model Event {
  id        String       @id @default(cuid())
  title     String
  date      DateTime
  createdAt DateTime     @default(now())
  images    EventImage[]
}

model EventImage {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  url         String
  key         String
  width       Int
  height      Int
  blurDataUrl String
  order       Int
  createdAt   DateTime @default(now())

  @@index([eventId])
}

model Yearbook {
  id          String   @id @default(cuid())
  title       String
  year        Int
  coverUrl    String?
  coverKey    String?
  blurDataUrl String?
  pdfUrl      String
  pdfKey      String
  fileSize    Int
  createdAt   DateTime @default(now())

  @@index([year])
}
